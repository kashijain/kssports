PORT=47291
MONGODB_URI=mongodb://127.0.0.1:27017/lekha
JWT_SECRET=change-this-to-a-long-random-string
# Shows password-reset links in the app when no mail server is configured.
# Production keeps this off unless it is explicitly true.
EXPOSE_RESET_LINK=true
# Local sample shop only. Production never seeds, even when this is true.
SEED_DEMO=true
CHROME_PATH=/usr/local/bin/google-chrome
CLIENT_ORIGIN=http://127.0.0.1:47291
COOKIE_SECURE=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Leave empty for local development. The Vite dev server proxies /api.
# On Vercel, set this to the Render origin with no trailing slash.
VITE_API_URL=
